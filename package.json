{
  "name": "universal-x-studio",
  "version": "0.1.0",
  "description": "Universal X Studio — a modular desktop creation workspace.",
  "main": "main.js",
  "author": "Universal X Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.universalx.studio",
    "productName": "Universal X Studio",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "index.html", "styles.css", "renderer.js", "node_modules/jsqr/**/*"],
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
